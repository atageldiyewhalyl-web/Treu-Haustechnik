# Optional override for the server-side inquiry workflow.
# The default points to the deployed treu-anfrage Supabase Edge Function.
SUPABASE_INQUIRY_URL=https://<project-ref>.supabase.co/functions/v1/treu-anfrage
SUPABASE_INQUIRY_SECRET=

# Both secrets stay server-side; never prefix them with NEXT_PUBLIC_.
# RESEND_API_KEY stays in Supabase Edge Function secrets and is not needed by Next.js.
