# Inquiry form (app/api/anfrage/route.ts). Nothing is stored: the inquiry goes straight to the owner by email.
RESEND_API_KEY=
# Where inquiries land
INQUIRY_TO=info@treuhaustechnik.de
# Sender; the domain must be verified in Resend
INQUIRY_FROM="Treu Haustechnik Website <anfrage@treu-haustechnik.de>"
